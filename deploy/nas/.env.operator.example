# Copy to deploy/nas/.env.operator on EACH operator PC.
# Empty required values must be filled in.  Do not copy one COMPUTE_NODE_ID to
# several computers: it is the stable owner of locally-created calculations.

APP_ENV=production
COMPUTE_NODE_ID=
# Local persistent directory; do not copy its generated instance-id to another PC.
OPERATOR_STATE_HOST_PATH=./.operator-state

# The NAS is storage only. Use its stable Tailscale DNS name or IP.
DATABASE_URL=
MINIO_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_SECURE=false

# Redis is intentionally local. Never point this at the NAS or at another PC.
REDIS_URL=redis://redis:6379/0

# The operator uses this PC's API only. Do not expose it to LAN/WAN/Tailscale.
API_BIND_ADDRESS=127.0.0.1
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
INTERNAL_API_URL=http://api:8000

# Keep database connection use small because PostgreSQL runs on weak NAS
# hardware. These values are consumed by current NAS-mode application builds.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
# A lease only lets another process on THIS physical PC resume after a crash;
# it never makes the job eligible on a different COMPUTE_NODE_ID.
JOB_LEASE_SECONDS=900
JOB_HEARTBEAT_SECONDS=60

# Local incoming directory used only by this PC's watcher and import worker.
# Windows example: C:/PrinterLogs
# macOS/Linux example: ./raw_logs
RAW_LOGS_HOST_PATH=C:/PrinterLogs
RAW_LOGS_CONTAINER_PATH=/mnt/raw_logs
INCOMING_PATH=/mnt/raw_logs/incoming
STARTUP_IMPORT_ENABLED=false
WATCH_MODE=filesystem_events
REQUIRE_OPERATOR_IMPORT_CONFIRMATION=true

# Use unique secrets for service-to-service calls. They may be different on
# each PC because no other PC calls this local API.
AGENT_API_TOKEN=
API_SERVICE_TOKEN=

# Optional local LLM. Set null when this PC has no model server.
LLM_PROVIDER=null
