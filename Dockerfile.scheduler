# syntax=docker/dockerfile:1.7
# scheduler image — cron jobs + bounded historical re-analysis. Needs the light
# analytics tier (polars, scipy, networkx and small scikit-learn models) but none
# of the heavy SLM / 3D packages. Carries: base + analytics (same tier as worker).
FROM ghcr.io/artemivanchenko/printers-companion:base

COPY requirements.analytics.txt /app/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --progress-bar off -r requirements.analytics.txt

COPY . /app
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --progress-bar off --no-deps -e .
USER app

ARG APP_VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
ARG SOURCE_STATE=unknown
ENV APP_VERSION=$APP_VERSION \
    GIT_COMMIT=$GIT_COMMIT \
    BUILD_DATE=$BUILD_DATE \
    SOURCE_STATE=$SOURCE_STATE
LABEL org.opencontainers.image.version="$APP_VERSION" \
      org.opencontainers.image.revision="$GIT_COMMIT" \
      org.opencontainers.image.created="$BUILD_DATE" \
      io.printers-companion.source-state="$SOURCE_STATE" \
      org.opencontainers.image.source="https://github.com/ArtemIvanchenko/Printers-companion"
