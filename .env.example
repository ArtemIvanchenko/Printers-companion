# Этот файл — для переопределения дефолтов. Без него тоже всё работает.
# Чтобы изменить настройки: cp .env.example .env, затем отредактируйте .env.

# ── Пути ──────────────────────────────────────────────────────────────────────
# Папка на хосте, куда кладутся логи принтера (по умолчанию ./raw_logs).
# RAW_LOGS_HOST_PATH=./raw_logs

# ── База данных ────────────────────────────────────────────────────────────────
# На каждом операторском ПК задайте СВОЙ стабильный идентификатор. Он закрепляет
# локальные расчёты за тем ПК, где оператор создал задание.
# COMPUTE_NODE_ID=operator-01
# Локальная папка хранит автоматически созданный UUID физического ПК. Не
# копируйте её на другой компьютер вместе с .env.
# OPERATOR_STATE_HOST_PATH=./.operator-state
# Пароль PostgreSQL (по умолчанию change-me — подходит для localhost).
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql+psycopg://printer_logs:change-me@postgres:5432/printer_logs
# Для слабого NAS не увеличивайте без измерений: значения применяются к каждому
# процессу API/worker/estimator отдельно.
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=2
# После перезапуска задача снова подхватывается только этим же ПК не позднее
# чем через 15 минут; активный расчёт продлевает аренду раз в минуту.
# JOB_LEASE_SECONDS=900
# JOB_HEARTBEAT_SECONDS=60
# API_WORKERS=1

# ── LLM (опционально) ─────────────────────────────────────────────────────────
# Отключён по умолчанию. Для включения:
# LLM_PROVIDER=lmstudio
# LLM_BASE_URL=http://host.docker.internal:1234/v1
# LLM_MODEL=qwen3.6

# ── Прочее ────────────────────────────────────────────────────────────────────
# Полный список переменных с дефолтами — в x-app-env секции docker-compose.yml.
